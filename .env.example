APP_NAME=Camillo
APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=camillo
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
POSTGRES_DB=camillo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

EMBEDDING_DIM=1024

INFERENCE_CHAT_MODEL=openrouter/google/gemma-4-31b-it:free
INFERENCE_EMBEDDING_MODEL=BAAI/bge-m3
INFERENCE_RERANK_MODEL=openrouter/cohere/rerank-4-pro
INFERENCE_CHAT_ENDPOINT=https://openrouter.ai/api/v1
INFERENCE_EMBEDDING_ENDPOINT=http://complex.home.arpa:8102/v1
INFERENCE_RERANK_ENDPOINT=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

PHOENIX_TRACING_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=https://phoenix-otlp.${DOCKER_DOMAIN}/v1/traces
PHOENIX_PROJECT_NAME=camillo

DECAY_RATE=0.01
RECALL_TOP_K=5
RECALL_VECTOR_LIMIT=30
RECALL_FULL_TEXT_SEARCH_LIMIT=30

# Retrieval controls
RERANK_ENABLED=true
RERANK_MIN_SCORE=0.35
RRF_K=60
RECALL_CANDIDATE_LIMIT=30

# Dreaming / consolidation
DREAMING_ENABLED=true
DREAMING_INTERVAL_SECONDS=900
DREAMING_DRY_RUN=false
DREAMING_SEED_LIMIT=5
DREAMING_BATCH_SIZE=5
DREAMING_MIN_SIMILARITY=0.75
DREAMING_MIN_SYNTHESIS_CONFIDENCE=0.6
DREAMING_MODEL=
