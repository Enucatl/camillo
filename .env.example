APP_NAME=Camillo
APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=camillo
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
POSTGRES_DB=camillo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

EMBEDDING_DIM=1024

LITELLM_COMPLETION_MODEL=openrouter/google/gemma-4-31b-it:free
LITELLM_EMBEDDING_MODEL=openrouter/baai/bge-m3
LITELLM_RERANK_MODEL=openrouter/cohere/rerank-4-pro
OPENROUTER_API_KEY=

PHOENIX_TRACING_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=https://phoenix-otlp.${DOCKER_DOMAIN}/v1/traces
PHOENIX_PROJECT_NAME=camillo

DECAY_RATE=0.01
RECALL_TOP_K=5
RECALL_VECTOR_LIMIT=30
RECALL_FULL_TEXT_SEARCH_LIMIT=30

# Phase 2 recall controls
RERANK_ENABLED=true
RERANK_MIN_SCORE=0.35
RRF_K=60
RECALL_CANDIDATE_LIMIT=30
RECALL_RELEVANCE_WEIGHT=0.7
RECALL_ACTIVATION_WEIGHT=0.3
DIVERSITY_ENABLED=true
DIVERSITY_SIMILARITY_THRESHOLD=0.92
HEBBIAN_SPREAD_ENABLED=true
HEBBIAN_SPREAD_LIMIT=3
HEBBIAN_MAX_DEPTH=1
HEBBIAN_EDGE_THRESHOLD=2.0
REINFORCEMENT_ENABLED=true
REINFORCEMENT_EDGE_INCREMENT=1.0

# Dreaming / consolidation
DREAMING_ENABLED=true
DREAMING_INTERVAL_SECONDS=900
DREAMING_RUN_ON_START=false
DREAMING_NAMESPACE=default
DREAMING_DRY_RUN=false
DREAMING_SEED_LIMIT=5
DREAMING_CLUSTER_MAX_SIZE=12
DREAMING_CLUSTER_MIN_SIZE=2
DREAMING_MAX_DEPTH=2
DREAMING_MIN_SEED_ACTIVATION=0.35
DREAMING_MIN_EDGE_WEIGHT=2.0
DREAMING_MAX_CLUSTER_AGE_DAYS=90
DREAMING_MIN_CLUSTER_TOTAL_IMPORTANCE=1.0
DREAMING_MIN_SYNTHESIS_CONFIDENCE=0.6
DREAMING_MAX_MEMORIES_PER_CLUSTER=3
DREAMING_SOURCE_PENALTY=0.35
DREAMING_MIN_SOURCE_IMPORTANCE=0.05
DREAMING_RELATION_CONFIDENCE=0.85
DREAMING_MODEL=
