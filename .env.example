APP_NAME="Cognitive Memory Stack"
APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=cognitive
POSTGRES_PASSWORD=cognitive
POSTGRES_DB=cognitive_memory
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://cognitive:cognitive@postgres:5432/cognitive_memory

EMBEDDING_DIM=1536

LITELLM_COMPLETION_MODEL=openai/gpt-4o-mini
LITELLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LITELLM_RERANK_MODEL=

PHOENIX_TRACING_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix.docker.home.arpa:6006
PHOENIX_PROJECT_NAME=camillo

DECAY_RATE=0.01
RECALL_TOP_K=5
RECALL_VECTOR_LIMIT=30
RECALL_FTS_LIMIT=30
HEBBIAN_EDGE_THRESHOLD=2.0
